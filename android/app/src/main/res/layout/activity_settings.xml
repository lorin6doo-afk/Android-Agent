<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sopotnik — nastavitve"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Backend"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ws://ime-naprave:8787 (Tailscale)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/edit_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="žeton (SOPOTNIK_TOKEN z backenda)"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btn_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preizkusi povezavo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Navigacija"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="domači naslov (za »navigiraj domov«)"
            android:inputType="textPostalAddress" />

        <EditText
            android:id="@+id/edit_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="naslov službe"
            android:inputType="textPostalAddress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Vedenje"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sw_confirm_calls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glasovna potrditev pred klicem (rumena stopnja)" />

        <Switch
            android:id="@+id/sw_follow_up"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Po odgovoru poslušaj nadaljevanje" />

        <Switch
            android:id="@+id/sw_realtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sven Live — realtime glas (zahteva OPENAI_API_KEY na Macu)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sistemski asistent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_assistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="…"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_assistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nastavi Svena kot privzetega digitalnega pomočnika" />

        <Button
            android:id="@+id/btn_miui_perms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xiaomi: druga dovoljenja (zaklenjen zaslon, okna v ozadju)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nato na Xiaomiju: Nastavitve → Dodatne nastavitve → Bližnjice gumbov → Zaženi digitalnega pomočnika → Pridrži gumb za vklop. Svena zaženeš z dolgim pritiskom (0,5 s), deluje tudi na zaklenjenem zaslonu. Po ponovnem zagonu telefona deluje šele po prvem odklepu. »Hey Google« se s tem izklopi."
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_lock_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <Switch
            android:id="@+id/sw_calls_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Klici priljubljenih stikov (zvezdica) tudi ob zaklenjenem telefonu" />

        <Switch
            android:id="@+id/sw_nav_locked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navigacija do izgovorjenega javnega cilja ob zaklenjenem telefonu (nikoli domov ali v službo)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Dovoljenja"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_perms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dodeli dovoljenja (mikrofon, stiki, klici)" />

        <Button
            android:id="@+id/btn_notif_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dostop do obvestil (nadzor glasbe)" />

        <Button
            android:id="@+id/btn_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prikaz nad drugimi aplikacijami (odpiranje zaslonov iz ozadja)" />

        <Button
            android:id="@+id/btn_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Branje zaslona (dostopnost) — sporočila, ki jih ni več med obvestili" />

        <Button
            android:id="@+id/btn_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🩺 Diagnostika obvestil" />

        <Button
            android:id="@+id/btn_audit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pokaži dnevnik dejanj" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Shrani" />
    </LinearLayout>
</ScrollView>
