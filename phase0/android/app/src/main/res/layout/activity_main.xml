<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sopotnik — faza 0"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preizkus slovenskega govora in vzdržljivosti v ozadju (Xiaomi 14 Pro)"
            android:textSize="13sp" />

        <!-- 1 · STT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1 · Prepoznava govora (STT)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_stt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🎤  Začni poslušanje" />

        <CheckBox
            android:id="@+id/chk_echo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Ponovi za mano (prepoznano besedilo prebere TTS)" />

        <CheckBox
            android:id="@+id/chk_offline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Zahtevaj offline prepoznavo (test brez omrežja)" />

        <TextView
            android:id="@+id/stt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pripravljen."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stt_partial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/stt_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <!-- 2 · TTS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2 · Sinteza govora (TTS)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_tts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:text="Pozdravljen! Jaz sem Sven, tvoj sopotnik. Šumniki: čas, žoga, širina. Danes je četrtek, osemindvajsetega avgusta." />

        <Button
            android:id="@+id/btn_tts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🔊  Izgovori" />

        <Button
            android:id="@+id/btn_install_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⬇️  Namesti slovenski glas"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tts_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <!-- 3 · Test ozadja -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3 · Test ozadja (HyperOS)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zaženi, zakleni telefon za 5–10 minut, odkleni in pritisni Osveži. Storitev vsakih 15 s zapiše »tick« — vrzeli ali ponovni zagoni razkrijejo poseg sistema."
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_fgs_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zaženi" />

            <Button
                android:id="@+id/btn_fgs_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ustavi" />

            <Button
                android:id="@+id/btn_fgs_refresh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Osveži" />
        </LinearLayout>

        <TextView
            android:id="@+id/fgs_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <!-- 4 · Dnevnik -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="4 · Diagnostika in dnevnik"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/diag_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋  Kopiraj poročilo" />

            <Button
                android:id="@+id/btn_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📤  Deli poročilo" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
