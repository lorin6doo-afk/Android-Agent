# Kopiraj v backend/.env in izpolni — datoteka .env ostane samo na tvojem Macu (je v .gitignore).
SOPOTNIK_TOKEN=tukaj-tvoj-dolgi-zeton
OPENAI_API_KEY=sk-...
SOPOTNIK_CITY=Mozirje

# Neobvezno:
# SOPOTNIK_RT_MODEL=gpt-realtime          # ceneje: gpt-realtime-mini
# SOPOTNIK_RT_VOICE=marin                 # tudi: cedar, alloy, sage, coral ...
# SOPOTNIK_MODEL=gpt-5.6-luna
# PORT=8787
